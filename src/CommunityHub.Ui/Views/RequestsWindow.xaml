<Window x:Class="CommunityHub.Ui.Views.RequestsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Moji zahtevi" Height="500" Width="900"
        WindowStartupLocation="CenterOwner" Background="#F4F6F7">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="White" Padding="15" CornerRadius="5" Margin="0,0,0,15">
            <StackPanel>
                <TextBlock Text="Moji zahtevi" FontSize="20" FontWeight="Bold" Foreground="#2C3E50" Margin="0,0,0,15"/>
                
                <WrapPanel Orientation="Horizontal">
                    <TextBlock Text="Filtriraj:" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="#555"/>
                    <ComboBox x:Name="cmbFilter" Width="200" Height="30" SelectionChanged="CmbFilter_SelectionChanged">
                        <ComboBoxItem Content="Svi zahtevi" IsSelected="True"/>
                        <ComboBoxItem Content="Na čekanju"/>
                        <ComboBoxItem Content="Odobreni"/>
                        <ComboBoxItem Content="Odbijeni"/>
                    </ComboBox>
                </WrapPanel>
            </StackPanel>
        </Border>

        <DataGrid x:Name="dgRequests" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" 
                  GridLinesVisibility="Horizontal" Background="White" RowBackground="#FFFFFF" 
                  AlternatingRowBackground="#F9FAFB" FontSize="14" BorderBrush="#D1D5DB" SelectionMode="Single">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID zahteva" Binding="{Binding Id}" Width="100"/>
                <DataGridTextColumn Header="Zgrada" Binding="{Binding BuildingId}" Width="150"/>
                <DataGridTextColumn Header="Stan" Binding="{Binding ApartmentNumber}" Width="100"/>
                <DataGridTextColumn Header="Datum" Binding="{Binding CreatedAt, StringFormat='dd.MM.yyyy HH:mm'}" Width="150"/>
                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="120"/>
                <DataGridTextColumn Header="Razlog odbijanja" Binding="{Binding RejectionReason}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>

        <Button x:Name="btnPovuciZahtev" Grid.Row="2" Content="❌ Povuci zahtev" 
                HorizontalAlignment="Right" Margin="0,10,0,0" Padding="20,10" FontSize="14" 
                Background="#E74C3C" Foreground="White" BorderThickness="0" Cursor="Hand" 
                Click="BtnPovuciZahtev_Click"/>
    </Grid>
</Window>