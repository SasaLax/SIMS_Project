<Window x:Class="CommunityHub.Ui.Views.HomeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="CommunityHub - Početna stranica" Height="500" Width="850"
        WindowStartupLocation="CenterScreen" Background="#F4F6F7">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#2C3E50" Padding="15">
            <Grid>
                <TextBlock x:Name="txtUloga" Text="Dobrodošli" Foreground="White" 
                           FontSize="16" VerticalAlignment="Center" FontWeight="SemiBold"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">

                    <!-- Dugmad za Stanara -->
                    <Button x:Name="btnPregledZgradaStanar" Content="🏢 Pregled zgrada" Click="BtnPregledZgrada_Click" 
                            Padding="15,8" Margin="0,0,10,0" FontSize="14" 
                            Background="#3498DB" Foreground="White" BorderThickness="0" Cursor="Hand" Visibility="Visible"/>
                    <Button x:Name="btnMojiZahtevi" Content="📋 Moji zahtevi" Click="BtnMojiZahtevi_Click" 
                            Padding="15,8" Margin="0,0,10,0" FontSize="14" 
                            Background="#1ABC9C" Foreground="White" BorderThickness="0" Cursor="Hand" Visibility="Visible"/>

                    <!-- Dugmad za Upravnika -->
                    <Button x:Name="btnMojeZgrade" Content="🏘 Moje zgrade" Click="BtnMojeZgrade_Click" 
                            Padding="15,8" Margin="0,0,10,0" FontSize="14" 
                            Background="#9B59B6" Foreground="White" BorderThickness="0" Cursor="Hand" Visibility="Collapsed"/>
                    

                    <!-- Dugmad za Administratora -->
                    <Button x:Name="btnDodajUpravnika" Content="👤 Dodaj upravnika" Click="BtnDodajUpravnika_Click" 
                            Padding="15,8" Margin="0,0,10,0" FontSize="14" 
                            Background="#F39C12" Foreground="White" BorderThickness="0" Cursor="Hand" Visibility="Collapsed"/>
                    <Button x:Name="btnDodajZgradu" Content="🏗 Dodaj zgradu" Click="BtnDodajZgradu_Click" 
                            Padding="15,8" Margin="0,0,10,0" FontSize="14" 
                            Background="#E67E22" Foreground="White" BorderThickness="0" Cursor="Hand" Visibility="Collapsed"/>

                    <Button Content="Odjavi se" Click="LogoutButton_Click" 
                            Padding="15,8" FontSize="14" 
                            Background="#E74C3C" Foreground="White" BorderThickness="0" Cursor="Hand"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="30">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="Dobrodošli u Community Hub" FontSize="24" FontWeight="Bold" Foreground="#2C3E50" HorizontalAlignment="Center"/>
                <TextBlock Text="Izaberite opciju iz gornjeg menija za rad." FontSize="14" Foreground="#7F8C8D" HorizontalAlignment="Center" Margin="0,10,0,0"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>