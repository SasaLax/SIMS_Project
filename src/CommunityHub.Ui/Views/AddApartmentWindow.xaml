<Window x:Class="CommunityHub.Ui.Views.AddApartmentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Dodaj stan" Height="450" Width="450"
        WindowStartupLocation="CenterOwner" Background="#F4F6F7">

    <Border Background="White" Margin="20" Padding="20" CornerRadius="5">
        <StackPanel>
            <TextBlock Text="Dodaj stan" FontSize="20" FontWeight="Bold" Foreground="#2C3E50" Margin="0,0,0,20"/>
            
            <TextBlock Text="Broj stana:" Foreground="#555" Margin="0,0,0,5"/>
            <TextBox x:Name="txtApartmentNumber" Height="30" FontSize="14" VerticalContentAlignment="Center" Margin="0,0,0,15" InputScope="Number"/>
            
            <TextBlock Text="Broj soba:" Foreground="#555" Margin="0,0,0,5"/>
            <TextBox x:Name="txtNumberOfRooms" Height="30" FontSize="14" VerticalContentAlignment="Center" Margin="0,0,0,15" InputScope="Number"/>
            
            <TextBlock Text="Maksimalan broj stanovnika:" Foreground="#555" Margin="0,0,0,5"/>
            <TextBox x:Name="txtMaxResidents" Height="30" FontSize="14" VerticalContentAlignment="Center" Margin="0,0,0,15" InputScope="Number"/>
            
            <Grid Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                
                <Button x:Name="btnCancel" Content="Odustani" Grid.Column="0" Click="BtnCancel_Click" 
                        Padding="10,8" FontSize="14" Background="#95A5A6" Foreground="White" BorderThickness="0" Margin="0,0,5,0"/>
                
                <Button x:Name="btnSubmit" Content="Dodaj stan" Grid.Column="1" Click="BtnSubmit_Click" 
                        Padding="10,8" FontSize="14" Background="#2ECC71" Foreground="White" BorderThickness="0" Margin="5,0,0,0"/>
            </Grid>
        </StackPanel>
    </Border>
</Window>