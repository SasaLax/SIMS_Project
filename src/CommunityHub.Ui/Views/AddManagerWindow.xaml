<Window x:Class="CommunityHub.Ui.Views.AddManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Dodaj upravnika" Height="620" Width="500"
        WindowStartupLocation="CenterOwner" Background="#F4F6F7">

    <Border Background="White" Margin="20" Padding="20" CornerRadius="5">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="Dodaj novog upravnika" FontSize="20" FontWeight="Bold" Foreground="#2C3E50" Margin="0,0,0,20"/>
                
                <TextBlock Text="Ime:" Foreground="#555" Margin="0,0,0,5"/>
                <TextBox x:Name="txtIme" Height="30" FontSize="14" VerticalContentAlignment="Center" Margin="0,0,0,15"/>
                
                <TextBlock Text="Prezime:" Foreground="#555" Margin="0,0,0,5"/>
                <TextBox x:Name="txtPrezime" Height="30" FontSize="14" VerticalContentAlignment="Center" Margin="0,0,0,15"/>
                
                <TextBlock Text="JMBG:" Foreground="#555" Margin="0,0,0,5"/>
                <TextBox x:Name="txtJmbg" Height="30" FontSize="14" VerticalContentAlignment="Center" Margin="0,0,0,15"/>
                
                <TextBlock Text="Email:" Foreground="#555" Margin="0,0,0,5"/>
                <TextBox x:Name="txtEmail" Height="30" FontSize="14" VerticalContentAlignment="Center" Margin="0,0,0,15"/>
                
                <TextBlock Text="Lozinka:" Foreground="#555" Margin="0,0,0,5"/>
                <PasswordBox x:Name="txtLozinka" Height="30" FontSize="14" Margin="0,0,0,15"/>
                
                <TextBlock Text="Broj telefona:" Foreground="#555" Margin="0,0,0,5"/>
                <TextBox x:Name="txtTelefon" Height="30" FontSize="14" VerticalContentAlignment="Center" Margin="0,0,0,20"/>
                
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    
                    <Button x:Name="btnCancel" Content="Odustani" Grid.Column="0" Click="BtnCancel_Click" 
                            Padding="10,8" FontSize="14" Background="#95A5A6" Foreground="White" BorderThickness="0" Margin="0,0,5,0"/>
                    
                    <Button x:Name="btnDodaj" Content="Dodaj upravnika" Grid.Column="1" Click="BtnDodaj_Click" 
                            Padding="10,8" FontSize="14" Background="#2ECC71" Foreground="White" BorderThickness="0" Margin="5,0,0,0"/>
                </Grid>
            </StackPanel>
        </ScrollViewer>
    </Border>
</Window>