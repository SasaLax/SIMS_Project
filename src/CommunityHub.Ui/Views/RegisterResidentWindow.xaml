<Window x:Class="CommunityHub.Ui.Views.RegisterResidentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Registracija stanara" Height="420" Width="400" WindowStartupLocation="CenterOwner">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Registracija stanara" FontSize="16" FontWeight="Bold" Margin="0,0,0,12"/>

        <StackPanel Grid.Row="1" VerticalAlignment="Top">
            <StackPanel Orientation="Horizontal">
                <TextBlock Width="100" VerticalAlignment="Center">JMBG:</TextBlock>
                <TextBox x:Name="txtJmbg" Width="240"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal">
                <TextBlock Width="100" VerticalAlignment="Center">Email:</TextBlock>
                <TextBox x:Name="txtEmail" Width="240"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal">
                <TextBlock Width="100" VerticalAlignment="Center">Lozinka:</TextBlock>
                <PasswordBox x:Name="pwdPassword" Width="240"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal">
                <TextBlock Width="100" VerticalAlignment="Center">Ime:</TextBlock>
                <TextBox x:Name="txtName" Width="240"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal">
                <TextBlock Width="100" VerticalAlignment="Center">Prezime:</TextBlock>
                <TextBox x:Name="txtSurname" Width="240"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal">
                <TextBlock Width="100" VerticalAlignment="Center">Mobilni:</TextBlock>
                <TextBox x:Name="txtPhone" Width="240"/>
            </StackPanel>
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Width="90" Click="BtnCancel_Click">Odustani</Button>
            <Button Width="110" Click="BtnRegister_Click">Registruj se</Button>
        </StackPanel>
    </Grid>
</Window>