<Window x:Class="CommunityHub.Ui.Views.BuildingSearchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pregled i pretraga stambenih zgrada" Height="650" Width="950"
        WindowStartupLocation="CenterOwner" Background="#F4F6F7">

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="White" Padding="15" CornerRadius="5" Margin="0,0,0,15">
            <StackPanel>
                <TextBlock Text="Pretraga stambenih zgrada" FontSize="18" FontWeight="Bold" Foreground="#2C3E50" Margin="0,0,0,15"/>

                <WrapPanel Orientation="Horizontal" Margin="0,0,0,10">
                    <StackPanel Margin="0,0,15,0">
                        <TextBlock Text="Pretraga po adresi:" Margin="0,0,0,5" Foreground="#555"/>
                        <TextBox x:Name="txtAddress" Width="180" Height="30" FontSize="14" VerticalContentAlignment="Center" TextChanged="Txt_TextChanged"/>
                    </StackPanel>

                    <StackPanel Margin="0,0,15,0">
                        <TextBlock Text="Pretraga po naselju:" Margin="0,0,0,5" Foreground="#555"/>
                        <TextBox x:Name="txtNeighbourhood" Width="180" Height="30" FontSize="14" VerticalContentAlignment="Center" TextChanged="Txt_TextChanged"/>
                    </StackPanel>

                    <StackPanel Margin="0,0,15,0">
                        <TextBlock Text="Broj spratova:" Margin="0,0,0,5" Foreground="#555"/>
                        <TextBox x:Name="txtFloors" Width="100" Height="30" FontSize="14" VerticalContentAlignment="Center" TextChanged="Txt_TextChanged"/>
                    </StackPanel>

                    <StackPanel Margin="0,0,15,0">
                        <TextBlock Text="Stanovi (Sobe / Sobe &amp; Stanari):" Margin="0,0,0,5" Foreground="#555" ToolTip="Primjeri unosa: '2' (samo sobe), '2 &amp; 3' (sobe i stanari), '2 | 3' (sobe ili stanari)"/>
                        <TextBox x:Name="txtApartments" Width="200" Height="30" FontSize="14" VerticalContentAlignment="Center" TextChanged="Txt_TextChanged"/>
                    </StackPanel>
                </WrapPanel>

                <Grid Margin="0,10,0,0">
                    <CheckBox x:Name="chkSortFloors" Content="Sortiraj prikaz po broju spratova" 
                              HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="14" 
                              Checked="ChkSortFloors_Changed" Unchecked="ChkSortFloors_Changed"/>
                </Grid>
            </StackPanel>
        </Border>

        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            
            <DataGrid x:Name="dgBuildings" AutoGenerateColumns="False" IsReadOnly="True" 
                      GridLinesVisibility="Horizontal" Background="White" RowBackground="#FFFFFF" 
                      AlternatingRowBackground="#F9FAFB" FontSize="14" BorderBrush="#D1D5DB" SelectionMode="Single" Grid.Row="0">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="ID Zgrade" Binding="{Binding Id}" Width="100"/>
                    <DataGridTextColumn Header="Kod zgrade" Binding="{Binding BuildingCode}" Width="130"/>
                    <DataGridTextColumn Header="Adresa" Binding="{Binding FullAddress}" Width="2*"/>
                    <DataGridTextColumn Header="Naselje" Binding="{Binding Neighbourhood}" Width="1.5*"/>
                    <DataGridTextColumn Header="Lokacija" Binding="{Binding FullLocation}" Width="1.5*"/>
                    <DataGridTextColumn Header="Broj spratova" Binding="{Binding NumberOfFloors}" Width="120"/>
                </DataGrid.Columns>
            </DataGrid>
            
            <Button x:Name="btnPodnesiZahtev" Content="📝 Podnesi zahtev za stan" Grid.Row="1" 
                    HorizontalAlignment="Right" Margin="0,10,0,0" Padding="20,10" FontSize="14" 
                    Background="#3498DB" Foreground="White" BorderThickness="0" Cursor="Hand" 
                    Click="BtnPodnesiZahtev_Click"/>
        </Grid>
    </Grid>
</Window>