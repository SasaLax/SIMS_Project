<Window x:Class="CommunityHub.Ui.Views.ManagerBuildingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Moje zgrade" Height="600" Width="1000"
        WindowStartupLocation="CenterOwner" Background="#F4F6F7">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="White" Padding="15" CornerRadius="5" Margin="0,0,0,15">
            <StackPanel>
                <TextBlock Text="Moje zgrade" FontSize="20" FontWeight="Bold" Foreground="#2C3E50" Margin="0,0,0,15"/>
                
                <WrapPanel Orientation="Horizontal">
                    <TextBlock Text="Filtriraj:" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="#555"/>
                    <ComboBox x:Name="cmbFilter" Width="200" Height="30" SelectionChanged="CmbFilter_SelectionChanged">
                        <ComboBoxItem Content="Sve zgrade" IsSelected="True"/>
                        <ComboBoxItem Content="Na čekanju"/>
                        <ComboBoxItem Content="Odobrene"/>
                    </ComboBox>
                </WrapPanel>
            </StackPanel>
        </Border>

        <DataGrid x:Name="dgBuildings" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" 
                  GridLinesVisibility="Horizontal" Background="White" RowBackground="#FFFFFF" 
                  AlternatingRowBackground="#F9FAFB" FontSize="14" BorderBrush="#D1D5DB" SelectionMode="Single">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID Zgrade" Binding="{Binding Id}" Width="100"/>
                <DataGridTextColumn Header="Adresa" Binding="{Binding FullAddress}" Width="2*"/>
                <DataGridTextColumn Header="Naselje" Binding="{Binding Neighbourhood}" Width="1.5*"/>
                <DataGridTextColumn Header="Lokacija" Binding="{Binding FullLocation}" Width="1.5*"/>
                <DataGridTextColumn Header="Broj spratova" Binding="{Binding NumberOfFloors}" Width="120"/>
                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="120"/>
            </DataGrid.Columns>
        </DataGrid>

        <WrapPanel Grid.Row="2" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button x:Name="btnOdobriZgradu" Content="✅ Odobri zgradu" 
                    Padding="20,10" FontSize="14" Background="#2ECC71" Foreground="White" 
                    BorderThickness="0" Cursor="Hand" Click="BtnOdobriZgradu_Click" Margin="0,0,10,0"/>
            <Button x:Name="btnOdbijZgradu" Content="❌ Odbij zgradu" 
                    Padding="20,10" FontSize="14" Background="#E74C3C" Foreground="White" 
                    BorderThickness="0" Cursor="Hand" Click="BtnOdbijZgradu_Click" Margin="0,0,10,0"/>
            <Button x:Name="btnPogledajZahteve" Content="📋 Pogledaj zahteve" 
                    Padding="20,10" FontSize="14" Background="#3498DB" Foreground="White" 
                    BorderThickness="0" Cursor="Hand" Click="BtnPogledajZahteve_Click" Margin="0,0,10,0"/>
            <Button x:Name="btnDodajStan" Content="🏠 Dodaj stan" 
                    Padding="20,10" FontSize="14" Background="#F39C12" Foreground="White" 
                    BorderThickness="0" Cursor="Hand" Click="BtnDodajStan_Click"/>
        </WrapPanel>
    </Grid>
</Window>