<Window x:Class="CommunityHub.Ui.Views.RejectReasonWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Razlog odbijanja" Height="350" Width="400"
        WindowStartupLocation="CenterOwner" Background="#F4F6F7">

    <Border Background="White" Margin="20" Padding="20" CornerRadius="5">
        <StackPanel>
            <TextBlock Text="Unesite razlog odbijanja:" FontSize="16" FontWeight="Bold" Foreground="#2C3E50" Margin="0,0,0,15"/>
            <TextBox x:Name="txtReason" Height="80" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"/>
            
            <Grid Margin="0,20,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                
                <Button x:Name="btnCancel" Content="Odustani" Grid.Column="0" Click="BtnCancel_Click" 
                        Padding="10,8" FontSize="14" Background="#95A5A6" Foreground="White" BorderThickness="0" Margin="0,0,5,0"/>
                
                <Button x:Name="btnSubmit" Content="Odbij zahtev" Grid.Column="1" Click="BtnSubmit_Click" 
                        Padding="10,8" FontSize="14" Background="#E74C3C" Foreground="White" BorderThickness="0" Margin="5,0,0,0"/>
            </Grid>
        </StackPanel>
    </Border>
</Window>