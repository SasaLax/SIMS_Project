<Window x:Class="CommunityHub.Ui.Views.AddBuildingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Dodaj zgradu" Height="450" Width="550"
        WindowStartupLocation="CenterOwner" Background="#F4F6F7">

    <Border Background="White" Margin="20" Padding="20" CornerRadius="5">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="Dodaj novu zgradu" FontSize="20" FontWeight="Bold" Foreground="#2C3E50" Margin="0,0,0,20"/>

                <!-- ZAMIJENJENO: Kod zgrade umjesto ID -->
                <TextBlock Text="Kod zgrade:" Foreground="#555" Margin="0,0,0,5"/>
                <TextBox x:Name="txtBuildingCode" Height="30" FontSize="14" VerticalContentAlignment="Center" Margin="0,0,0,15"/>

                <TextBlock Text="Ulica:" Foreground="#555" Margin="0,0,0,5"/>
                <TextBox x:Name="txtUlica" Height="30" FontSize="14" VerticalContentAlignment="Center" Margin="0,0,0,15"/>

                <TextBlock Text="Broj:" Foreground="#555" Margin="0,0,0,5"/>
                <TextBox x:Name="txtBroj" Height="30" FontSize="14" VerticalContentAlignment="Center" Margin="0,0,0,15"/>

                <TextBlock Text="Naselje:" Foreground="#555" Margin="0,0,0,5"/>
                <TextBox x:Name="txtNaselje" Height="30" FontSize="14" VerticalContentAlignment="Center" Margin="0,0,0,15"/>

                <TextBlock Text="Grad:" Foreground="#555" Margin="0,0,0,5"/>
                <TextBox x:Name="txtGrad" Height="30" FontSize="14" VerticalContentAlignment="Center" Margin="0,0,0,15"/>

                <TextBlock Text="Država:" Foreground="#555" Margin="0,0,0,5"/>
                <TextBox x:Name="txtDrzava" Height="30" FontSize="14" VerticalContentAlignment="Center" Margin="0,0,0,15"/>

                <TextBlock Text="Broj spratova:" Foreground="#555" Margin="0,0,0,5"/>
                <TextBox x:Name="txtSpratovi" Height="30" FontSize="14" VerticalContentAlignment="Center" Margin="0,0,0,15"/>

                <TextBlock Text="JMBG upravnika:" Foreground="#555" Margin="0,0,0,5"/>
                <TextBox x:Name="txtUpravnikJmbg" Height="30" FontSize="14" VerticalContentAlignment="Center" Margin="0,0,0,20"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Button x:Name="btnCancel" Content="Odustani" Grid.Column="0" Click="BtnCancel_Click" 
                            Padding="10,8" FontSize="14" Background="#95A5A6" Foreground="White" BorderThickness="0" Margin="0,0,5,0"/>

                    <Button x:Name="btnDodaj" Content="Dodaj zgradu" Grid.Column="1" Click="BtnDodaj_Click" 
                            Padding="10,8" FontSize="14" Background="#2ECC71" Foreground="White" BorderThickness="0" Margin="5,0,0,0"/>
                </Grid>
            </StackPanel>
        </ScrollViewer>
    </Border>
</Window>