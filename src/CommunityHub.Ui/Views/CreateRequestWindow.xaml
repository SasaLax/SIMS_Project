<Window x:Class="CommunityHub.Ui.Views.CreateRequestWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Podnesi zahtev za stan" Width="450" SizeToContent="Height"
        MinHeight="300" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" Background="#F4F6F7">

    <Border Background="White" Margin="20" Padding="20" CornerRadius="5">
        <StackPanel>
            <TextBlock Text="Podnesi zahtev za stan" FontSize="20" FontWeight="Bold" Foreground="#2C3E50" Margin="0,0,0,20"/>
            
            <TextBlock Text="Odabrana zgrada:" Foreground="#555" Margin="0,0,0,5"/>
            <TextBox x:Name="txtBuilding" IsReadOnly="True" Height="30" FontSize="14" VerticalContentAlignment="Center" Margin="0,0,0,15"/>
            
            <TextBlock Text="Broj stana:" Foreground="#555" Margin="0,0,0,5"/>
            <TextBox x:Name="txtApartmentNumber" Height="30" FontSize="14" VerticalContentAlignment="Center" Margin="0,0,0,15" InputScope="Number"/>
            
            <Border x:Name="pnlWarning" Visibility="Collapsed" Background="#FFF3CD" Padding="10" Margin="0,0,0,15">
                <StackPanel>
                    <TextBlock Text="⚠ Upozorenje" FontWeight="Bold" Foreground="#856404" FontSize="14"/>
                    <TextBlock x:Name="txtWarning" Foreground="#856404" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <Grid Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                
                <Button x:Name="btnCancel" Content="Odustani" Grid.Column="0" Click="BtnCancel_Click" 
                        Padding="10,8" FontSize="14" Background="#95A5A6" Foreground="White" BorderThickness="0" Margin="0,0,5,0"/>
                
                <Button x:Name="btnSubmit" Content="Podnesi zahtev" Grid.Column="1" Click="BtnSubmit_Click" 
                        Padding="10,8" FontSize="14" Background="#2ECC71" Foreground="White" BorderThickness="0" Margin="5,0,0,0"/>
            </Grid>
        </StackPanel>
    </Border>
</Window>